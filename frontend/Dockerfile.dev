# Local dev image (docker-compose) — runs the TanStack Start SSR dev server with hot reload.
# Separate from ./Dockerfile, which builds the static Cloud Run production bundle.
FROM oven/bun:1.2
WORKDIR /app

COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile

COPY . .

EXPOSE 5173
CMD ["bun", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
