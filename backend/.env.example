# Same project as frontend/.env — Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Settings -> API -> service_role (secret, server-only, bypasses RLS). Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of origins allowed to call this API.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000
